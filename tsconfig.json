{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    // `client.js` (codigo do navegador) vai para o `dist/` junto: o plugin le o arquivo ao lado dele.
    "allowJs": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}
